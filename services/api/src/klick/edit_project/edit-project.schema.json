{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klick.app/schemas/edit-project/1.0.json",
  "title": "EditProject",
  "description": "Documento de edición de un clip (docs/07 §2). Fuente única de la vista previa y del render. Tiempos en milisegundos enteros; coordenadas normalizadas 0-1 respecto al lienzo. Las reglas que cruzan campos (referencias, solapes, duraciones) las validan las funciones semánticas de Python y TypeScript, comprobadas con los mismos fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canvas", "sources", "layout", "timeline", "audio"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "canvas": { "$ref": "#/$defs/Canvas" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/Source" }
    },
    "layout": { "$ref": "#/$defs/Layout" },
    "timeline": { "$ref": "#/$defs/Timeline" },
    "captions": { "$ref": "#/$defs/Captions" },
    "audio": { "$ref": "#/$defs/AudioSettings" }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "description": "Identificador local del documento (minúsculas, dígitos, guion y guion bajo)."
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "StyleRef": {
      "type": "string",
      "pattern": "^tpl:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Referencia a una plantilla; se resuelve al renderizar."
    },
    "Ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000,
      "description": "Milisegundos enteros (máximo 24 h)."
    },
    "Unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "Color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/Unit" },
        "y": { "$ref": "#/$defs/Unit" }
      }
    },
    "Canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 4096, "multipleOf": 2 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096, "multipleOf": 2 },
        "fps": { "enum": [24, 25, 30, 50, 60] },
        "background": { "$ref": "#/$defs/Color", "default": "#000000" }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "asset_id": { "$ref": "#/$defs/Uuid" },
        "kind": { "enum": ["video", "audio", "image"] }
      }
    },
    "Layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["follow", "split", "fit", "manual"] },
        "split": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_source", "bottom_source", "ratio"],
          "properties": {
            "top_source": { "$ref": "#/$defs/Id" },
            "bottom_source": { "$ref": "#/$defs/Id" },
            "ratio": { "type": "number", "minimum": 0.1, "maximum": 0.9 }
          }
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background"],
          "properties": {
            "background": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "color"],
              "properties": {
                "type": { "const": "solid" },
                "color": { "$ref": "#/$defs/Color" }
              }
            }
          }
        },
        "follow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "smoothing": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.85 },
            "subject": { "enum": ["face", "none"], "default": "face" }
          }
        }
      }
    },
    "Keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t_ms"],
      "properties": {
        "t_ms": { "$ref": "#/$defs/Ms" },
        "scale": { "type": "number", "minimum": 1, "maximum": 8, "default": 1 },
        "x": { "$ref": "#/$defs/Unit", "default": 0.5 },
        "y": { "$ref": "#/$defs/Unit", "default": 0.5 },
        "ease": { "enum": ["linear", "in", "out", "inout"], "default": "linear" }
      }
    },
    "Crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "$ref": "#/$defs/Unit" },
        "y": { "$ref": "#/$defs/Unit" },
        "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "VideoItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "source_in_ms", "source_out_ms", "start_ms"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "source_id": { "$ref": "#/$defs/Id" },
        "source_in_ms": { "$ref": "#/$defs/Ms" },
        "source_out_ms": { "$ref": "#/$defs/Ms" },
        "start_ms": { "$ref": "#/$defs/Ms" },
        "speed": { "type": "number", "minimum": 0.25, "maximum": 4, "default": 1 },
        "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 },
        "fade_in_ms": { "$ref": "#/$defs/Ms", "default": 0 },
        "fade_out_ms": { "$ref": "#/$defs/Ms", "default": 0 },
        "crop": { "$ref": "#/$defs/Crop" },
        "keyframes": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/Keyframe" }
        }
      }
    },
    "AudioItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "source_in_ms", "source_out_ms", "start_ms"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "source_id": { "$ref": "#/$defs/Id" },
        "source_in_ms": { "$ref": "#/$defs/Ms" },
        "source_out_ms": { "$ref": "#/$defs/Ms" },
        "start_ms": { "$ref": "#/$defs/Ms" },
        "speed": { "type": "number", "minimum": 0.25, "maximum": 4, "default": 1 },
        "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 },
        "fade_in_ms": { "$ref": "#/$defs/Ms", "default": 0 },
        "fade_out_ms": { "$ref": "#/$defs/Ms", "default": 0 }
      }
    },
    "TextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_ms", "end_ms", "text", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "start_ms": { "$ref": "#/$defs/Ms" },
        "end_ms": { "$ref": "#/$defs/Ms" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "style_ref": { "$ref": "#/$defs/StyleRef" },
        "position": { "$ref": "#/$defs/Point" },
        "align": { "enum": ["left", "center", "right"], "default": "center" }
      }
    },
    "ImageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "start_ms", "end_ms", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "source_id": { "$ref": "#/$defs/Id" },
        "start_ms": { "$ref": "#/$defs/Ms" },
        "end_ms": { "$ref": "#/$defs/Ms" },
        "position": { "$ref": "#/$defs/Point" },
        "scale": { "type": "number", "minimum": 0.01, "maximum": 4, "default": 1 }
      }
    },
    "VideoTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "const": "video" },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/VideoItem" } }
      }
    },
    "AudioTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "const": "audio" },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/AudioItem" } }
      }
    },
    "TextTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "const": "text" },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/TextItem" } }
      }
    },
    "ImageTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "const": "image" },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/ImageItem" } }
      }
    },
    "Timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "tracks"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 1, "maximum": 14400000 },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/VideoTrack" },
              { "$ref": "#/$defs/AudioTrack" },
              { "$ref": "#/$defs/TextTrack" },
              { "$ref": "#/$defs/ImageTrack" }
            ]
          }
        }
      }
    },
    "Captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id"],
      "properties": {
        "track_id": { "$ref": "#/$defs/Uuid" },
        "style_ref": { "$ref": "#/$defs/StyleRef" },
        "safe_area": { "enum": ["shorts", "none"], "default": "shorts" }
      }
    },
    "AudioSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalize"],
      "properties": {
        "normalize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "target_lufs": { "type": "number", "minimum": -30, "maximum": -5, "default": -14 },
            "true_peak_db": { "type": "number", "minimum": -9, "maximum": 0, "default": -1.5 }
          }
        },
        "ducking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    }
  }
}
